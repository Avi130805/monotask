[43.795237, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mThe commit failed\u001b[21Gbecause g\u001b[31Gt has no\u001b[41Guthor iden\u001b[52Gity configured here. I haven'\u001b[83Gset one, sinc\u001b[97G that's your\r\u001b[2C\u001b[1Bnam\u001b[7G and email\u001b[18Gto\u001b[21Gchoose.\r\u001b[2B \u001b[3GThe fix is staged (\u001b[38;2;177;185;249msrc/auth/callback.js\u001b[43G\u001b[39monly).\u001b[50GYou\u001b[54Gcan\u001b[58Geither:\r\u001b[2C\u001b[1B-\u001b[5Grun\u001b[9G\u001b[38;2;177;185;249m! git config user.name \"Your Name\"\u001b[44G\u001b[39mand\u001b[48G\u001b[38;2;177;185;249m! git config user.email \"you@example.com\"\u001b[90G\u001b[39m(repo-local),\u001b[104Gand\r\u001b[1B    I'll commit, or\u001b[K\r\u001b[2C\u001b[1B-\u001b[5Gtell\u001b[10Gme\u001b[13Gwhich\u001b[19Gidentity\u001b[28Gto\u001b[31Guse.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDashboard check:\u001b[20G\u001b[22m\u001b[38;2;177;185;249mrenderDashboard\u001b[36G\u001b[39min\u001b[39G\u001b[38;2;177;185;249msrc/dashboard.js\u001b[56G\u001b[39mdoesn't\u001b[64Gread\u001b[69Gthe\u001b[73Gsession\u001b[81Gcookie.\u001b[89GAfter\u001b[95Gsign-in\u001b[103Gthe\r\u001b[2C\u001b[1Bredirect lands\u001b[18Gon\u001b[21Ga\u001b[23Gpage\u001b[28Gthat\u001b[33Grenders,\u001b[42Gbut\u001b[46Gthe\u001b[50Gpage\u001b[55Gdoesn't\u001b[63Gdepend\u001b[70Gon\u001b[73Gthe\u001b[77Gsession.\u001b[86GTwo\u001b[90Gthings\u001b[97Gfollow\u001b[104Gfrom\r\u001b[2C\u001b[1Bthat:\r\u001b[1B \u001b[3G- \u001b[38;2;177;185;249m/\u001b[7Gashboard\u001b[39m is\u001b[19Greachable without\u001b[38Gign\u001b[42Gng in.\u001b[49GT\u001b[51Gat's separate from the redirect, so\u001b[87GI didn't\u001b[96Gchange it.\u001b[K\r\u001b[2C\u001b[1B- Sessions are stored in an in-memory\u001b[41G\u001b[38;2;177;185;249mMap\u001b[39m.\u001b[46GIf\u